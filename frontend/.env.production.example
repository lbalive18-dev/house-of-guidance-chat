# House of Guidance Chat - frontend PRODUCTION environment template.
# These are baked in at build time (Vite inlines VITE_* vars into the
# static bundle), so set them as build args in docker-compose.prod.yml
# (already wired up there) rather than expecting a mounted .env at runtime.

VITE_API_URL=https://api.chat.example.org
VITE_REVERB_APP_KEY=CHANGE_ME_matches_backend_REVERB_APP_KEY
VITE_REVERB_HOST=ws.chat.example.org
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
