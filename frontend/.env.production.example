# House of Guidance Chat - frontend PRODUCTION environment template.
# These are baked in at build time (Vite inlines VITE_* vars into the
# static bundle). Two production paths exist:
#  - Oracle path: set these to the api./ws. duckdns hosts (build args in
#    docker-compose.prod.yml are already wired up there).
#  - Render/Cloudflare path: VITE_API_URL is the Worker host itself
#    (same-origin; axios uses '/'), VITE_REVERB_HOST is the Render API
#    host dialed directly over wss (Render supports WebSockets).
# Never commit real hosts with secrets; there are no secrets here.

VITE_API_URL=https://CHANGE_ME.workers.dev
VITE_REVERB_APP_KEY=CHANGE_ME_matches_backend_REVERB_APP_KEY
VITE_REVERB_HOST=CHANGE_ME.onrender.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
