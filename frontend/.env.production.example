# House of Guidance Chat - frontend PRODUCTION environment template.
# These are baked in at build time (Vite inlines VITE_* vars into the
# static bundle).
# Cloudflare Worker serves the SPA and proxies same-origin API/auth/storage
# calls to the Render backend. The production Worker URL is configured; VITE_REVERB_HOST is the Render host, dialed directly
# over WSS so Reverb does not consume Worker request quota.
# Never commit real hosts with secrets; there are no secrets here.

VITE_API_URL=https://house-of-guidance-chat.lbalive18.workers.dev
VITE_REVERB_APP_KEY=CHANGE_ME_matches_Render_REVERB_APP_KEY
VITE_REVERB_HOST=house-of-guidance-chat.onrender.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
