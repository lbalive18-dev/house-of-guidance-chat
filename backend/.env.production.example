# House of Guidance Chat - PRODUCTION environment template.
# Copy to `.env`, fill in every placeholder, then `php artisan key:generate`.
# Never commit the real .env file.

APP_NAME="House of Guidance Chat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.houseofguidancechat.duckdns.org
FRONTEND_URL=https://chat.houseofguidancechat.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database -----------------------------------------------------------
# For docker-compose.prod.yml these also populate the mysql container's
# root/user passwords - keep them in sync.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=house_of_guidance_chat
DB_USERNAME=hog_prod_user
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
DB_ROOT_PASSWORD=CHANGE_ME_use_a_different_long_random_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.houseofguidancechat.duckdns.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -----------------------------------------------------------------
# Brevo's free tier (300 emails/day) is plenty for verification/reset
# emails at small-to-moderate scale, and costs nothing. Any SMTP provider
# works the same way.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@houseofguidancechat.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

# --- CORS / Sanctum -------------------------------------------------------
# Must exactly match your real frontend domain (scheme + host, no path).
SANCTUM_STATEFUL_DOMAINS=chat.houseofguidancechat.duckdns.org
CORS_ALLOWED_ORIGINS=https://chat.houseofguidancechat.duckdns.org
TRUSTED_PROXIES=*

# --- Realtime (Reverb) ------------------------------------------------------
# REVERB_HOST is the public hostname clients connect to (advertised in app
# options). The server bind address is REVERB_SERVER_HOST below — keep it
# 0.0.0.0 inside Docker. Do not set REVERB_HOST=0.0.0.0 (was broken).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hogchat-prod
REVERB_APP_KEY=CHANGE_ME_random_string
REVERB_APP_SECRET=CHANGE_ME_random_string
REVERB_HOST=ws.houseofguidancechat.duckdns.org
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- WebRTC ICE (voice/video calls) ----------------------------------------
# STUN defaults to Google's public server in code if unset. TURN is only
# advertised to clients when all three TURN_* vars are set — never commit
# real TURN credentials to the repository. A self-hosted coturn on this
# same free VM is the $0 path to symmetric-NAT reliability (see audit).
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.org:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Compose-only vars (read by docker-compose.prod.yml / Caddyfile) ------
APP_DOMAIN=chat.houseofguidancechat.duckdns.org
API_DOMAIN=api.houseofguidancechat.duckdns.org
REVERB_DOMAIN=ws.houseofguidancechat.duckdns.org

ALADHAN_API_URL=https://api.aladhan.com/v1
ALQURAN_API_URL=https://api.alquran.cloud/v1
