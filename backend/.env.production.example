# House of Guidance Chat - PRODUCTION environment template.
# Copy to `.env`, fill in every placeholder, then `php artisan key:generate`.
# Never commit the real .env file.

APP_NAME="House of Guidance Chat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.chat.example.org
FRONTEND_URL=https://chat.example.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database -----------------------------------------------------------
# For docker-compose.prod.yml these also populate the mysql container's
# root/user passwords - keep them in sync.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=house_of_guidance_chat
DB_USERNAME=hog_prod_user
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
DB_ROOT_PASSWORD=CHANGE_ME_use_a_different_long_random_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.chat.example.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -----------------------------------------------------------------
# Brevo's free tier (300 emails/day) is plenty for verification/reset
# emails at small-to-moderate scale, and costs nothing. Any SMTP provider
# works the same way.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@chat.example.org"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

# --- CORS / Sanctum -------------------------------------------------------
# Must exactly match your real frontend domain (scheme + host, no path).
SANCTUM_STATEFUL_DOMAINS=chat.example.org
CORS_ALLOWED_ORIGINS=https://chat.example.org
TRUSTED_PROXIES=*

# --- Realtime (Reverb) ------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hogchat-prod
REVERB_APP_KEY=CHANGE_ME_random_string
REVERB_APP_SECRET=CHANGE_ME_random_string
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# --- Compose-only vars (read by docker-compose.prod.yml / Caddyfile) ------
APP_DOMAIN=chat.example.org
API_DOMAIN=api.chat.example.org
REVERB_DOMAIN=ws.chat.example.org

ALADHAN_API_URL=https://api.aladhan.com/v1
ALQURAN_API_URL=https://api.alquran.cloud/v1
