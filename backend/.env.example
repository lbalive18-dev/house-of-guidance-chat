APP_NAME="House of Guidance Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=house_of_guidance_chat
DB_USERNAME=hog_user
DB_PASSWORD=hog_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@houseofguidance.org"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hogchat
REVERB_APP_KEY=hogchatkey
REVERB_APP_SECRET=hogchatsecret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Server bind address for `php artisan reverb:start` (no Docker required).
# Defaults in config/reverb.php are 0.0.0.0:8080, matching the Docker
# `reverb` service command. Only set these if you need to override.
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# WebRTC ICE servers for voice/video calls (comma-separated). TURN is only
# advertised to clients when URL + username + credential are ALL set — never
# commit real TURN credentials to the repository.
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.org:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

ALADHAN_API_URL=https://api.aladhan.com/v1
ALQURAN_API_URL=https://api.alquran.cloud/v1
