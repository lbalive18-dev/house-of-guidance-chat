# House of Guidance Chat - RENDER FREE-TIER environment template (no card).
# Single-service deployment: Render web service (supervisord) + Neon
# Postgres + Upstash Redis + Supabase Storage + Brevo HTTPS mail.
# Copy to `.env`, fill in every placeholder, then deploy. Never commit .env.
# The Oracle/MySQL path keeps using backend/.env.production.example.

APP_NAME="House of Guidance Chat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Public Render service URL, assigned at creation (https://<name>.onrender.com)
APP_URL=https://CHANGE_ME.onrender.com
# Cloudflare Worker host serving the frontend (https://<name>.workers.dev)
FRONTEND_URL=https://CHANGE_ME.workers.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Neon Postgres, sslmode=require) ---------------------------
DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME-pooler-host.neon.tech
DB_PORT=5432
DB_DATABASE=CHANGE_ME_db_name
DB_USERNAME=CHANGE_ME_db_user
DB_PASSWORD=CHANGE_ME_db_password
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cross-site Worker frontend requires SameSite=None + Secure cookies.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# --- Cache + queue (Upstash Redis over TLS) --------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Paste the full rediss:// URL from Upstash (includes password + TLS).
REDIS_URL=rediss://default:CHANGE_ME@CHANGE_ME.upstash.io:6379
REDIS_CLIENT=phpredis

# --- Mail (Brevo HTTPS API; Render free blocks SMTP ports) -----------------
MAIL_MAILER=brevo-api
BREVO_API_KEY=CHANGE_ME_brevo_api_key
BREVO_API_URL=https://api.brevo.com/v3
MAIL_FROM_ADDRESS="noreply@houseofguidance.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Uploads (Supabase Storage S3 API; Render disks are ephemeral) ---------
FILESYSTEM_DISK=public
PUBLIC_DISK_DRIVER=supabase
AVATARS_DISK_DRIVER=supabase
CHAT_ATTACHMENTS_DISK_DRIVER=supabase
VOICE_NOTES_DISK_DRIVER=supabase
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVICE_KEY=CHANGE_ME_service_role_key
SUPABASE_BUCKET=hog-uploads
# Public object URLs (bucket must be PUBLIC, mirroring public/storage).
PUBLIC_DISK_URL=https://CHANGE_ME.supabase.co/storage/v1/object/public/hog-uploads
AVATARS_DISK_URL=https://CHANGE_ME.supabase.co/storage/v1/object/public/hog-uploads/avatars/
CHAT_ATTACHMENTS_DISK_URL=https://CHANGE_ME.supabase.co/storage/v1/object/public/hog-uploads/chat-attachments/
VOICE_NOTES_DISK_URL=https://CHANGE_ME.supabase.co/storage/v1/object/public/hog-uploads/voice-notes/

SANCTUM_STATEFUL_DOMAINS=CHANGE_ME.workers.dev
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.workers.dev
TRUSTED_PROXIES=*

# --- Realtime (self-hosted Reverb inside the same container) ----------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hogchat-render
REVERB_APP_KEY=CHANGE_ME_random_string
REVERB_APP_SECRET=CHANGE_ME_random_string
# Public client-facing host (the Render service itself, wss on 443).
REVERB_HOST=CHANGE_ME.onrender.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- WebRTC ICE -------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
# No free no-card TURN configured (STUN-only launch). Add coturn later:
# TURN_URLS=turn:turn.example.org:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

ALADHAN_API_URL=https://api.aladhan.com/v1
ALQURAN_API_URL=https://api.alquran.cloud/v1
